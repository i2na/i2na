---
import type { GetStaticPaths } from "astro";
import Listing from "../../components/Listing.astro";
import Base from "../../layouts/Base.astro";
import { localePaths, locales, t, type Locale } from "../../lib/i18n";
import { getPosts } from "../../lib/posts";

export const getStaticPaths = (() => locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const posts = await getPosts();
---

<Base lang={lang} description={t(lang, "description")} paths={localePaths()}>
  <Listing lang={lang} posts={posts} shown={posts} />
</Base>
