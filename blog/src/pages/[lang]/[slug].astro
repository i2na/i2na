---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Icon from "../../components/Icon.astro";
import Share from "../../components/Share.astro";
import Thumb from "../../components/Thumb.astro";
import Toc from "../../components/Toc.astro";
import Base from "../../layouts/Base.astro";
import { langTag, localePath, localePaths, locales, t } from "../../lib/i18n";
import { formatDate, getPosts, neighborsOf, ogImageOf, relatedOf, tagSlug, viewOf } from "../../lib/posts";
import { site } from "../../lib/site";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return locales.flatMap((lang) => posts.map((post) => ({ params: { lang, slug: post.slug }, props: { lang, post, posts } })));
}) satisfies GetStaticPaths;

const { lang, post, posts } = Astro.props;
const view = viewOf(post, lang);
const { Content, headings } = await render(view.entry);
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3 && heading.slug !== "footnote-label");
const related = relatedOf(post, posts).map((other) => viewOf(other, lang));
const { newer, older } = neighborsOf(post, posts);
const pager = [
  older && { view: viewOf(older, lang), label: t(lang, "prev"), icon: "arrow-left" as const },
  newer && { view: viewOf(newer, lang), label: t(lang, "next"), icon: "arrow-right" as const },
].filter((item) => !!item);
const url = new URL(localePath(lang, post.slug), site.url).href;
const image = await ogImageOf(view);
const contentLang = langTag[view.contentLang];
const fallbackLang = (item: typeof view) => (item.fallback ? langTag[item.contentLang] : undefined);
const tagLinks = view.tags.map((tag) => ({ tag, href: localePath(lang, "tags", tagSlug(tag)) }));
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: view.title,
  description: view.description,
  datePublished: post.date.toISOString(),
  inLanguage: contentLang,
  image: new URL(image, site.url).href,
  url,
  author: { "@type": "Person", name: site.author, url: site.bio },
};
---

<Base
  lang={lang}
  title={view.title}
  description={view.description}
  paths={localePaths(post.slug)}
  alternates={locales.filter((code) => post.entries[code])}
  image={image}
  article={{ published: post.date, tags: post.tags }}
  backdrop="plain"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <div class="progress" aria-hidden="true"></div>
  <article class:list={["frame grid grid-cols-[minmax(0,1fr)] pt-8 lg:justify-center lg:gap-x-14 lg:pt-14", toc.length ? "lg:grid-cols-[minmax(0,720px)_200px]" : "lg:grid-cols-[minmax(0,720px)]"]}>
    <header class="mx-auto w-full max-w-[720px] lg:col-start-1">
      <a class="inline-flex items-center gap-1.5 text-[0.86rem] text-muted transition-colors hover:text-ink" href={localePath(lang)} data-reveal>
        <Icon name="arrow-left" class="size-4" />
        <span>{t(lang, "back")}</span>
      </a>
      <p class="mt-8 font-mono text-[0.72rem] tracking-[0.08em] text-quiet lg:mt-10" data-reveal>
        <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
      </p>
      <h1 class="mt-3 text-[1.85rem] leading-[1.25] font-[760] tracking-[-0.01em] text-balance sm:text-[2.2rem] lg:text-[2.5rem]" lang={fallbackLang(view)} data-reveal>
        {view.title}
      </h1>
      <p class="mt-4 text-[1.02rem] leading-[1.65] text-muted sm:text-[1.08rem]" lang={fallbackLang(view)} data-reveal>{view.description}</p>
      <div class="mt-6 flex flex-wrap items-center justify-between gap-x-4 gap-y-3" data-reveal>
        <ul class="flex flex-wrap gap-2">
          {
            tagLinks.map(({ tag, href }) => (
              <li>
                <a class="tag-chip" href={href}>
                  #{tag}
                </a>
              </li>
            ))
          }
        </ul>
        <Share lang={lang} title={view.title} url={url} />
      </div>
      {
        view.fallback && (
          <p class="mt-6 flex items-center gap-2.5 rounded-[10px] border border-hairline-soft bg-paper-warm px-3.5 py-2.5 text-[0.88rem] leading-[1.5] text-ink-soft" data-reveal>
            <span class="badge">KO</span>
            <span>{t(lang, "koreanOnly")}</span>
          </p>
        )
      }
    </header>

    <div class="thumb post-hero mx-auto mt-8 w-full max-w-[720px] lg:col-start-1 lg:mt-10">
      <Thumb view={view} sizes="(min-width: 800px) 720px, 100vw" eager />
    </div>

    <div class="prose mx-auto mt-10 w-full max-w-[720px] lg:col-start-1 lg:mt-12" lang={contentLang}>
      <Content />
    </div>

    {toc.length > 0 && <Toc lang={lang} headings={toc} />}

    <footer class="mx-auto mt-16 w-full max-w-[720px] lg:col-start-1 lg:mt-20">
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 border-t border-hairline-soft pt-6">
        <ul class="flex flex-wrap gap-2">
          {
            tagLinks.map(({ tag, href }) => (
              <li>
                <a class="tag-chip" href={href}>
                  #{tag}
                </a>
              </li>
            ))
          }
        </ul>
        <Share lang={lang} title={view.title} url={url} />
      </div>

      <a class="group mt-10 flex items-center gap-4" href={`${site.bio}/?lang=${lang}`} data-reveal>
        <span class="grid size-11 flex-none place-items-center rounded-full border border-hairline bg-white">
          <img src="/favicon.svg" alt="" width="20" height="20" />
        </span>
        <span class="min-w-0 flex-1">
          <span class="block text-[0.98rem] font-bold text-ink">{site.author}</span>
          <span class="phrase mt-0.5 block text-[0.86rem] text-muted">{t(lang, "role")}</span>
        </span>
        <span class="flex flex-none items-center gap-1 text-[0.84rem] text-muted transition-colors group-hover:text-blue">
          <span>{t(lang, "profile")}</span>
          <Icon name="arrow-right" class="size-4" />
        </span>
      </a>

      {
        related.length > 0 && (
          <section class="mt-14" data-reveal>
            <h2 class="text-[0.74rem] font-semibold tracking-[0.02em] text-quiet">{t(lang, "related")}</h2>
            <ul class="mt-4 grid gap-4">
              {related.map((item) => {
                const href = localePath(lang, item.slug);
                return (
                  <li class="group relative flex items-center gap-4">
                    <div class="thumb w-28 flex-none sm:w-36" data-thumb={href}>
                      <Thumb view={item} sizes="144px" />
                    </div>
                    <div class="min-w-0">
                      <p class="font-mono text-[0.68rem] tracking-[0.08em] text-quiet">
                        <time datetime={item.date.toISOString()}>{formatDate(item.date)}</time>
                      </p>
                      <h3 class="mt-1 line-clamp-2 text-[0.98rem] leading-[1.45] font-semibold text-ink transition-colors group-hover:text-blue" lang={fallbackLang(item)}>
                        <a class="after:absolute after:inset-0 after:content-['']" href={href}>
                          {item.title}
                        </a>
                      </h3>
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }

      {
        pager.length > 0 && (
          <nav class="mt-14 grid gap-6 border-t border-hairline-soft pt-6 sm:grid-cols-2" aria-label={t(lang, "pager")} data-reveal>
            {pager.map(({ view: item, label, icon }) => (
              <a class:list={["group block", icon === "arrow-right" && "sm:col-start-2 sm:text-right"]} href={localePath(lang, item.slug)}>
                <span class:list={["flex items-center gap-1 text-[0.76rem] text-quiet", icon === "arrow-right" && "sm:justify-end"]}>
                  {icon === "arrow-left" && <Icon name={icon} class="size-3.5" />}
                  <span>{label}</span>
                  {icon === "arrow-right" && <Icon name={icon} class="size-3.5" />}
                </span>
                <span class="phrase mt-1.5 line-clamp-2 text-[0.98rem] leading-[1.45] font-semibold text-ink transition-colors group-hover:text-blue" lang={fallbackLang(item)}>
                  {item.title}
                </span>
              </a>
            ))}
          </nav>
        )
      }
    </footer>
  </article>
  <script>
    import "../../scripts/post";
  </script>
</Base>
