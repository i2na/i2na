---
import type { MarkdownHeading } from "astro";
import { t, type Locale } from "../lib/i18n";

interface Props {
  lang: Locale;
  headings: MarkdownHeading[];
}

const { lang, headings } = Astro.props;
---

<nav class="toc hidden lg:sticky lg:top-8 lg:col-start-2 lg:row-start-3 lg:block lg:max-h-[calc(100svh-4rem)] lg:self-start lg:overflow-y-auto" aria-label={t(lang, "contents")}>
  <p class="text-[0.74rem] font-semibold tracking-[0.02em] text-quiet">{t(lang, "contents")}</p>
  <ol class="mt-3 border-l border-hairline">
    {
      headings.map((heading) => (
        <li>
          <a
            class:list={[
              "-ml-px block border-l-2 border-transparent py-[5px] leading-[1.45] text-muted transition-colors hover:text-ink aria-[current=true]:border-blue aria-[current=true]:text-ink",
              heading.depth > 2 ? "pl-6 text-[0.8rem]" : "pl-3.5 text-[0.84rem]",
            ]}
            href={`#${heading.slug}`}
          >
            {heading.text}
          </a>
        </li>
      ))
    }
  </ol>
</nav>
