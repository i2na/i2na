---
import { langTag, localePath, t } from "../lib/i18n";
import { formatDate, tagSlug, type PostView } from "../lib/posts";
import Thumb from "./Thumb.astro";

interface Props {
  view: PostView;
}

const { view } = Astro.props;
const href = localePath(view.lang, view.slug);
const contentLang = view.fallback ? langTag[view.contentLang] : undefined;
---

<article class="group relative">
  <div class="thumb [&_img]:transition-transform [&_img]:duration-500 [&_img]:ease-out group-hover:[&_img]:scale-[1.02]" data-thumb={href}>
    <Thumb view={view} sizes="(min-width: 1280px) 384px, (min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw" />
  </div>
  <p class="mt-4 flex items-center gap-2 font-mono text-[0.7rem] tracking-[0.08em] text-quiet">
    <time datetime={view.date.toISOString()}>{formatDate(view.date)}</time>
    {view.fallback && <span class="badge" title={t(view.lang, "koreanOnly")}>KO</span>}
  </p>
  <h2 class="mt-2 line-clamp-2 text-[1.08rem] leading-[1.4] font-bold text-ink transition-colors group-hover:text-blue" lang={contentLang}>
    <a class="after:absolute after:inset-0 after:content-['']" href={href}>{view.title}</a>
  </h2>
  <p class="mt-2 line-clamp-3 text-[0.92rem] leading-[1.6] text-muted" lang={contentLang}>{view.description}</p>
  <ul class="relative mt-3 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[0.7rem] text-quiet">
    {
      view.tags.map((tag) => (
        <li>
          <a class="transition-colors hover:text-ink" href={localePath(view.lang, "tags", tagSlug(tag))}>
            #{tag}
          </a>
        </li>
      ))
    }
  </ul>
</article>
